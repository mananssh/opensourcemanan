# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.scratch/

# Owner's private agent prompts — kept out of the public repo; encoded into
# AGENT_PROMPTS_B64 via scripts/encode-prompts.mjs (the repo ships only the
# generic fallbacks in lib/agent/prompts.ts).
agent.prompts.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all real ones, but DO track the placeholder template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Copy to .env.local and fill in. NEVER commit real values — .env* is gitignored.

# Shared CockroachDB (Postgres-compatible) connection string.
# From the CockroachDB Cloud console: Connect → General connection string.
# Used at runtime by db/client.ts and by `npm run db:migrate`.
DATABASE_URL="postgresql://user:password@host:26257/defaultdb?sslmode=verify-full"

# --- Auth (NextAuth v5 / Auth.js + Google) ---
# Signs the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#                          http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated allowlist of owner accounts (your Google email). Anyone can
# sign in; only these are treated as the owner for owner-gated features.
OWNER_EMAILS=""
# PREVIEW env only (Vercel): route OAuth through the stable prod callback so one
# Google redirect URI covers all preview deployments. Leave unset for prod/local.
# AUTH_REDIRECT_PROXY_URL="https://<your-prod-domain>/api/auth"

# --- Storage (shared Cloudflare R2 bucket) ---
# R2 is S3-compatible; the app talks to it via the S3 SDK (see agent-kit/storage.md, ADR 0016).
# Cloudflare dashboard → R2 → your bucket → Settings for the account id, and
# → Manage R2 API Tokens to mint a token scoped to "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=""            # Cloudflare account id (the R2 endpoint is https://<id>.r2.cloudflarestorage.com)
R2_ACCESS_KEY_ID=""         # R2 API token — Access Key ID
R2_SECRET_ACCESS_KEY=""     # R2 API token — Secret Access Key
# PRIVATE bucket — every upload lands here; it must NOT have a public custom
# domain. Private/gated objects (Sully's prompts, dump images) live only here and
# are read via short-lived signed URLs. Defaults to osmprivate if unset.
R2_BUCKET="osmprivate"
# PUBLIC bucket — a SEPARATE bucket bound to the R2 custom domain below. makePublic
# copies an object here; only these objects are world-readable. See ADR 0016 for
# why two buckets (R2 has no per-object ACL, so a custom domain serves a whole bucket).
# NOTE: must be a DIFFERENT bucket from R2_BUCKET — never point both at the same one.
R2_PUBLIC_BUCKET="opensourcemanan"
# Public base URL: the custom domain bound to the PUBLIC bucket (no trailing slash).
# publicUrl(key) returns `${R2_PUBLIC_BASE_URL}/${key}`.
R2_PUBLIC_BASE_URL="https://assets.mananssh.com"

# --- Site ---
# Canonical origin for metadata / sitemap / RSS (no trailing slash).
# Defaults to the Vercel URL or localhost if unset.
NEXT_PUBLIC_SITE_URL="https://opensourcemanan.vercel.app"

# --- Agent (Sully — the live LangGraph.js fit agent at /api/fit) ---
# Model lanes are OpenAI-compatible; the router tries them in priority order and
# fails over on a 429/5xx. GEMINI_API_KEY is enough for live runs; with NO key
# the section still renders and the (clearly labeled) example replay works.
# Privacy: only the pasted JD flows through these — the NIM/OpenCode free tiers
# may log/train on data, so never route anything sensitive.
#
# Primary: Google Gemini (free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# GEMINI_MODEL_FAST="gemini-2.5-flash-lite"
# GEMINI_MODEL_STRONG="gemini-2.5-flash-lite"
# Failover lane 1: NVIDIA NIM (trial — logs data, dev/demo only). https://build.nvidia.com
NVIDIA_NIM_API_KEY=""
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_NIM_MODEL_FAST="meta/llama-3.1-8b-instruct"
# NVIDIA_NIM_MODEL_STRONG="meta/llama-3.3-70b-instruct"
# Failover lane 2: OpenCode Zen (rotating free roster — CONFIRM via GET
# /zen/v1/models; only the `-free` variants skip billing). https://opencode.ai
OPENCODE_ZEN_API_KEY=""
# OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
# OPENCODE_ZEN_MODEL="deepseek-v4-flash-free"
# Company web research (Tavily). Optional — web_corpus degrades to corpus-only
# if this is unset or rate-limited. Free ~1,000/mo. https://tavily.com
TAVILY_API_KEY=""
# Quota stewardship + safety knobs (defaults shown):
# AGENT_DAILY_CAP="200"          # global runs per rolling 24h
# AGENT_IP_HOURLY_CAP="12"       # per-IP runs per rolling hour
# AGENT_MAX_INPUT_CHARS="4000"   # max pasted JD length
# AGENT_NODE_TIMEOUT_MS="10000"  # idle (no-bytes) timeout per model call before failover
# AGENT_NODE_TIMEOUT_STRONG_MS="20000" # same, for strong-tier calls (big models are slower to first byte)
# AGENT_LANE_COOLDOWN_MS="60000" # how long a repeatedly-failing model lane is skipped
# AGENT_LANE_ORDER_FAST=""       # per-tier failover order, e.g. "gemini,opencode-zen,nvidia-nim"
# AGENT_LANE_ORDER_STRONG=""     # (unlisted lanes keep default position at the end)
# AGENT_RUN_DEADLINE_MS="52000"  # hard ceiling on model-call time for the whole run
#                                 # (keep well under the route's maxDuration=60)
# Sully's prompts are private (the gitignored agent.prompts.json). Two ways to
# supply them; the app prefers the R2 object, then the env blob, then fallbacks.
#  1. R2 object (preferred): set AGENT_PROMPTS_KEY and run `npm run prompts:upload`.
#     Editing a prompt is a re-upload with NO redeploy, and keeps env small.
#     NOTE: this key must live in a bucket WITHOUT a public custom domain (see
#     agent-kit/storage.md) — otherwise the private prompts become world-readable.
#  2. Env blob: run `npm run prompts:encode` to write AGENT_PROMPTS_B64 below.
#     Zero-dependency fallback for local/forks; also used if R2 is unreachable.
# With neither set, the agent runs on the generic fallbacks in lib/agent/prompts.ts.
# AGENT_PROMPTS_KEY="misc/agent-prompts.json"   # private object key
AGENT_PROMPTS_B64=""

# --- Ask Sully (the portfolio-wide chat overlay at /api/ask) ---
# A lightweight, general "ask about Manan" chat — shares the model lanes above
# (same GEMINI_API_KEY etc.), just with its own rate-limit caps (ask_runs
# table) since chat turns are far more frequent than one-shot fit runs.
# AGENT_ASK_DAILY_CAP="2000"        # global turns per rolling 24h
# AGENT_ASK_IP_HOURLY_CAP="60"      # per-IP turns per rolling hour
# AGENT_ASK_MAX_INPUT_CHARS="600"   # max chat message length
# AGENT_ASK_DEADLINE_MS="20000"     # hard ceiling on model-call time per turn

# --- Movies (TMDB — the Reel tracker at /movies) ---
# Title search + poster/metadata for the movie/TV tracker. TMDB is free for
# non-commercial use (IMDB has no free API). Create an account, then copy the
# v4 "API Read Access Token" from https://www.themoviedb.org/settings/api
# and paste it below (it's sent as a Bearer token). Responses are cached in the
# movie_cache table, so the free tier easily survives. With NO key the vertical
# still renders; only search degrades to empty.
TMDB_API_KEY=""
# TMDB_BASE_URL="https://api.themoviedb.org/3"
# TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"

# --- Vault (the private encrypted document store at /vault) ---
# A single-owner vault for sensitive documents (IDs, etc). STRICTER than the
# OWNER_EMAILS allowlist: ONLY this exact email can reach /vault or any of its
# routes/actions/APIs — everyone else (including other OWNER_EMAILS) gets a 404.
# Fail-closed: if unset, NOBODY can open the vault. Set your Google email here.
VAULT_OWNER_EMAIL=""
# Master key for envelope encryption. Every file is encrypted with a random
# per-file data key (AES-256-GCM); that data key is itself wrapped by THIS key
# before the row is stored. The raw bytes are never written anywhere in
# plaintext — not to R2, not to the DB, never to this public repo.
# Generate a fresh 32-byte key (base64) with:  openssl rand -base64 32
# Rotating it makes existing documents undecryptable, so treat it like a root
# secret: set once in .env.local + Vercel, never commit, never log.
VAULT_MASTER_KEY=""

# Copy to .env.local and fill in. NEVER commit real values — .env* is gitignored.

# Shared CockroachDB (Postgres-compatible) connection string.
# From the CockroachDB Cloud console: Connect → General connection string.
# Used at runtime by db/client.ts and by `npm run db:migrate`.
DATABASE_URL="postgresql://user:password@host:26257/defaultdb?sslmode=verify-full"

# --- Auth (NextAuth v5 / Auth.js + Google) ---
# Signs the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#                          http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated allowlist of owner accounts (your Google email). Anyone can
# sign in; only these are treated as the owner for owner-gated features.
OWNER_EMAILS=""
# PREVIEW env only (Vercel): route OAuth through the stable prod callback so one
# Google redirect URI covers all preview deployments. Leave unset for prod/local.
# AUTH_REDIRECT_PROXY_URL="https://<your-prod-domain>/api/auth"

# --- Storage (shared GCS bucket) ---
# Service-account creds. The account needs object admin on the bucket.
# Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add key (JSON).
# Accepts EITHER the raw JSON (single line) OR that JSON base64-encoded —
# base64 is recommended (no newline/quoting issues in Vercel or .env):
#   base64 < service-account.json | tr -d '\n'
GCP_SERVICE_ACCOUNT=""
# Bucket name (defaults to opensourcemanan if unset).
GCS_BUCKET="opensourcemanan"

# --- Site ---
# Canonical origin for metadata / sitemap / RSS (no trailing slash).
# Defaults to the Vercel URL or localhost if unset.
NEXT_PUBLIC_SITE_URL="https://opensourcemanan.vercel.app"

# --- Agent (Sully — the live LangGraph.js fit agent at /api/fit) ---
# Model lanes are OpenAI-compatible; the router tries them in priority order and
# fails over on a 429/5xx. GEMINI_API_KEY is enough for live runs; with NO key
# the section still renders and the (clearly labeled) example replay works.
# Privacy: only the pasted JD flows through these — the NIM/OpenCode free tiers
# may log/train on data, so never route anything sensitive.
#
# Primary: Google Gemini (free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# GEMINI_MODEL_FAST="gemini-2.0-flash"
# GEMINI_MODEL_STRONG="gemini-2.5-flash"
# Failover lane 1: NVIDIA NIM (trial — logs data, dev/demo only). https://build.nvidia.com
NVIDIA_NIM_API_KEY=""
# NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_NIM_MODEL_FAST="meta/llama-3.1-8b-instruct"
# NVIDIA_NIM_MODEL_STRONG="meta/llama-3.3-70b-instruct"
# Failover lane 2: OpenCode Zen (rotating free roster — CONFIRM via GET
# /zen/v1/models; only the `-free` variants skip billing). https://opencode.ai
OPENCODE_ZEN_API_KEY=""
# OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
# OPENCODE_ZEN_MODEL="deepseek-v4-flash-free"
# Company web research (Tavily). Optional — web_corpus degrades to corpus-only
# if this is unset or rate-limited. Free ~1,000/mo. https://tavily.com
TAVILY_API_KEY=""
# Quota stewardship + safety knobs (defaults shown):
# AGENT_DAILY_CAP="200"          # global runs per rolling 24h
# AGENT_IP_HOURLY_CAP="12"       # per-IP runs per rolling hour
# AGENT_MAX_INPUT_CHARS="4000"   # max pasted JD length
# AGENT_NODE_TIMEOUT_MS="10000"  # idle (no-bytes) timeout per model call before failover
# AGENT_LANE_COOLDOWN_MS="60000" # how long a repeatedly-failing model lane is skipped
# Sully's prompts are private — base64 of the gitignored agent.prompts.json.
# Generate/refresh with: npm run prompts:encode (writes this line into .env).
# Without it the agent runs on the generic public fallbacks in lib/agent/prompts.ts.
AGENT_PROMPTS_B64=""
